# Kleiner Webserver, über den der Tolino die Zeitung lädt.
# Läuft als *Benutzer*-Dienst: kein sudo für den Dienst selbst, kein fester Benutzername
# (%h steht für dein Home-Verzeichnis).
#
# Einrichten (einmalig):
#   mkdir -p ~/.config/systemd/user
#   ln -sf ~/morgenzeitung/morgenzeitung-web.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now morgenzeitung-web
#   sudo loginctl enable-linger $USER     # Dienst läuft auch ohne Anmeldung, z. B. nach Neustart
#
# Durch den Link (ln -s) gilt nach jedem "git pull" automatisch die neue Version
# (danach: systemctl --user daemon-reload && systemctl --user restart morgenzeitung-web).

[Unit]
Description=Morgenzeitung – Download-Seite fuer den Tolino

[Service]
ExecStartPre=/bin/mkdir -p %h/.local/share/morgenzeitung/ausgaben
ExecStart=/usr/bin/python3 -m http.server 8080 --directory %h/.local/share/morgenzeitung/ausgaben
Restart=on-failure

[Install]
WantedBy=default.target
